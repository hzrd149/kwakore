      "type": "relay.publish",
      "request": {
        "type": "relay.publish",
        "id": "p1",
        "event": {
          "kind": 1,
          "content": "hi",
          "tags": [],
          "created_at": 1
        }
      },
      "code": "internal-error",
      "expect": {
        "type": "relay.publish.result",
        "id": "p1",
        "ok": false,
        "error": "internal-error"
      }
    },
